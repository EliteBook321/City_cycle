# Comma-separated explicit frontend origins; set deployed Vercel origin for production.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
DATASET_PATH=backend/data/hour.csv
MODEL_ARTIFACT_PATH=backend/models/artifacts/citycycle_model.joblib
RANDOM_SEED=42
# Optional Groq key for AI explanations. Set only in backend/.env or host secrets.
# If previously exposed, revoke it at Groq and use a newly generated key here.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
